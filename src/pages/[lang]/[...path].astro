---
// AD-3 : route unique, génère toutes les entrées actives du registre (AD-2) dans les 4 langues.
// Choisit seulement le modèle ; le shell HTML est dans layouts/Base.astro (AD-13).
// Génère aussi la 404 de chaque langue en /{lang}/404/, déplacée en /{lang}/404.html par
// scripts/postbuild/not-found.mjs (chemin réservé par le registre).
import { LANGS, type Lang } from '../../lib/langs';
import { entries, NOT_FOUND_ID, NOT_FOUND_SEGMENT } from '../../lib/routes';
import Contact from '../../templates/Contact.astro';
import Home from '../../templates/Home.astro';
import NotFound from '../../templates/NotFound.astro';
import PathProbe from '../../templates/PathProbe.astro';
import Service from '../../templates/Service.astro';

export function getStaticPaths() {
  return [
    ...entries().map(({ id, lang, segments }) => ({
      params: { lang, path: segments.length > 0 ? segments.join('/') : undefined },
      props: { id, lang },
    })),
    ...LANGS.map((lang) => ({ params: { lang, path: NOT_FOUND_SEGMENT }, props: { id: NOT_FOUND_ID, lang } })),
  ];
}

interface Props {
  id: string;
  lang: Lang;
}

// Modèle par type d'id (préfixe avant « : », ex. `city:modiin` → `city`).
const TEMPLATES = { home: Home, contact: Contact, cameras: Service, 'smoke-detectors': Service, 'path-probe': PathProbe, 'not-found': NotFound } as const;

const { id, lang } = Astro.props;
const type = id.split(':')[0] as string;
if (!Object.hasOwn(TEMPLATES, type)) throw new Error(`routes : aucun modèle pour « ${id} » (type « ${type} »)`);
const Template = TEMPLATES[type as keyof typeof TEMPLATES];
---
<Template id={id} lang={lang} />
