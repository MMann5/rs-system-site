---
// FR19, FR20, UX-DR30, UX-DR33, AD-5, AD-6, AD-14, décision D1 : footer (DESIGN.md › Components › Footer).
// Colonnes de liens tirées de src/lib/nav (Services, Pour les entreprises, Zones, RS SYSTEM ; colonne
// vide omise), puis la colonne Contact, toujours rendue : numéro en lien d'appel mesuré, e-mail en
// <Placeholder> (D1, aucun lien e-mail tant que l'adresse n'existe pas), phrase de zone en texte simple.
// Ligne basse sous un filet : © + baseline (en hébreu dans les 4 langues, isolée en RTL hors hébreu),
// liens légaux (omis tant qu'aucun n'est actif), sélecteur de langues en variante claire.
// Grille : 1 colonne ; auto-fit dès 700px ; 5 colonnes au seuil du menu (960px he, 1200px sinon).
import { telHref } from '../lib/contact/core';
import { t } from '../lib/i18n';
import { footerColumns, legalNav } from '../lib/nav';
import type { PageContext } from '../lib/page-context';
import LanguageSwitcher from './LanguageSwitcher.astro';
import PhoneNumber from './PhoneNumber.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  ctx: PageContext;
}

const { ctx } = Astro.props;
const columns = footerColumns(ctx.lang);
const legal = legalNav(ctx.lang);
const contactHeading = t(ctx.lang, 'footer.col.contact');
const baseline = t('he', 'site.tagline');
---
<footer class="footer">
  <div class="inner">
    <div class="cols">
      {columns.map(({ heading, links }) => (
        <nav aria-label={heading} class="col">
          <h2 class="heading">{heading}</h2>
          <ul class="list">
            {links.map(({ href, label }) => (
              <li><a href={href} class="link">{label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
      <nav aria-label={contactHeading} class="col">
        <h2 class="heading">{contactHeading}</h2>
        <ul class="list">
          <li><a href={telHref()} class="link phone" data-track="call_click" data-placement="footer"><PhoneNumber /></a></li>
          <li class="item"><Placeholder text={t(ctx.lang, 'placeholder.email')} /></li>
          <li class="item">{t(ctx.lang, 'contact.zone')}</li>
        </ul>
      </nav>
    </div>
    <div class="bottom">
      <p class="copyright">{t(ctx.lang, 'footer.copyright')} · {ctx.lang === 'he' ? baseline : <bdi lang="he" dir="rtl">{baseline}</bdi>}</p>
      {legal.length > 0 && (
        <nav aria-label={t(ctx.lang, 'footer.legal-label')}>
          <ul class="legal">
            {legal.map(({ href, label }) => (
              <li><a href={href} class="link">{label}</a></li>
            ))}
          </ul>
        </nav>
      )}
      <LanguageSwitcher ctx={ctx} tone="light" placement="footer" />
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-surface-alt);
    color: var(--color-ink-muted);
    font-size: var(--type-small-size);
    font-weight: var(--type-small-weight);
    line-height: var(--type-small-leading);
  }

  .inner {
    max-inline-size: var(--container);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
    padding-block: var(--space-12) var(--space-6);
  }

  /* — Grille : 1 colonne ; dès --bp-mobile-bar (700px), auto-fit ; 5 colonnes au seuil du menu
   * (les @media ne lisent pas les tokens) : --bp-menu 960px en hébreu, --bp-menu-ltr 1200px sinon.
   * Pistes vides invisibles tant que les epics n'ont pas activé leurs pages. — */
  .cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (width >= 700px) {
    .cols {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--footer-col-min)), 1fr));
    }
  }

  @media (width >= 960px) {
    .footer:lang(he) .cols {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  @media (width >= 1200px) {
    .footer:not(:lang(he)) .cols {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  /* Titre de colonne : navy 700, 15px. */
  .heading {
    margin: 0;
    font-size: var(--type-small-size);
    font-weight: var(--type-h2-weight);
    line-height: var(--type-small-leading);
    color: var(--color-ink);
  }

  .list,
  .legal {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-6);
  }

  /* Cible ≥ 44px de haut (min-block-size 48px, texte centré). */
  .link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--space-12);
  }

  /* Lignes sans lien de la colonne Contact : bloc (une par ligne), même hauteur que les liens. */
  .item {
    display: flex;
    align-items: center;
    min-block-size: var(--space-12);
  }

  .link {
    color: var(--color-ink-muted);
    text-decoration: none;
  }

  .link:hover {
    text-decoration: underline;
  }

  /* Numéro : navy 700, chiffres en police latine. */
  .phone {
    font-family: var(--type-phone-inline-family);
    font-weight: var(--type-phone-inline-weight);
    color: var(--color-ink);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-4);
    /* Filet fin (mot-clé thin, 1px) : aucune largeur littérale hors tokens.css. */
    border-block-start: thin solid var(--color-line);
  }

  .copyright {
    margin: 0;
  }
</style>
