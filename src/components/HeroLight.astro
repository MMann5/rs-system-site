---
// FR2, FR31, UX-DR14, UX-DR18, UX-DR36, AD-5, AD-6, AD-9, AD-13 (story 3.1) : héros clair des pages services
// (DESIGN.md › Components › Héros photo, variante claire ; canvas Cameras.dc.html). Fond surface-alt, texte
// centré : h1 page-title navy, sous-titre service-subhead ink-muted, liens Appeler › WhatsApp › Devis ›
// (ton clair). WhatsApp porte le service du contexte de page ; Devis mène à Contact avec `?service=` du
// contexte, construit par bandLinks (comme le 3e lien du bloc contact), omis si `contact` est inactif.
// Photo encadrée sous le texte : 600px de haut dans --container au-dessus de 960px, 16:9 de 700 à 960px,
// source 4:5 dédiée sous 700px. Entrée : dézoom de la photo, montée décalée du texte (le h1 sans opacité) ;
// coupées par prefers-reduced-motion (base.css).
import type { ImageMetadata } from 'astro';
import { bandLinks } from '../lib/contact/band';
import { telHref, waHref } from '../lib/contact/core';
import { serviceLabels } from '../lib/contact/labels';
import { pageWaInput } from '../lib/contact/table';
import { t } from '../lib/i18n';
import type { PageContext } from '../lib/page-context';
import { FRAMED_PHOTO_SIZES } from '../lib/photos';
import { isEnabled, url } from '../lib/routes';
import ResponsivePhoto from './ResponsivePhoto.astro';
import TextLink from './TextLink.astro';

interface Props {
  ctx: PageContext;
  /** `focus` : point focal, jeton --photo-focus-{focus} de tokens.css. */
  photo: { src: ImageMetadata; portrait: ImageMetadata; alt: string; focus: 'dome' };
  title: string;
  subtitle: string;
}

const { ctx, photo, title, subtitle } = Astro.props;
const { lang } = ctx;
const wa = waHref(pageWaInput(ctx, serviceLabels('he')));
const { detailsHref: quoteHref } = bandLinks({ lang, service: ctx.service }, { isEnabled, url });
---
<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="title">{title}</h1>
  <p class="subtitle">{subtitle}</p>
  <div class="links">
    <TextLink href={telHref()} label={t(lang, 'action.call')} tone="light" track="call_click" placement="hero" />
    <TextLink href={wa} label={t(lang, 'action.whatsapp')} tone="light" track="whatsapp_click" placement="hero" />
    {quoteHref && <TextLink href={quoteHref} label={t(lang, 'action.quote')} tone="light" />}
  </div>
  <div class="frame" style={`--photo-position: var(--photo-focus-${photo.focus})`}>
    <ResponsivePhoto src={photo.src} portrait={photo.portrait} alt={photo.alt} sizes={FRAMED_PHOTO_SIZES} priority class="photo" />
  </div>
</section>

<style>
  /* Seuils (les @media ne lisent pas les tokens) : --bp-menu 960px, --bp-mobile-bar 700px. */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--hero-pad-top) 0;
    padding-inline: var(--page-gutter);
    background-color: var(--color-surface-alt);
    color: var(--color-navy);
    text-align: center;
  }

  @media (width < 960px) {
    .hero {
      padding-block-start: var(--hero-pad-top-tablet);
    }
  }

  @media (width < 700px) {
    .hero {
      padding-block-start: var(--hero-pad-top-mobile);
    }
  }

  .title {
    margin: 0;
    font-size: var(--type-page-title-size);
    font-weight: var(--type-page-title-weight);
    line-height: var(--type-page-title-leading);
    color: var(--color-navy);
    animation: light-rise-title var(--rise-duration) var(--ease) var(--rise-delay-1) both;
  }

  .subtitle {
    max-inline-size: var(--hero-light-subtitle-max);
    margin: 0;
    font-size: var(--type-service-subhead-size);
    font-weight: var(--type-service-subhead-weight);
    line-height: var(--type-service-subhead-leading);
    color: var(--color-ink-muted);
    animation: light-rise var(--rise-duration) var(--ease) var(--rise-delay-2) both;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: var(--link-gap);
    margin-block-start: var(--space-2);
    animation: light-rise var(--rise-duration) var(--ease) var(--rise-delay-3) both;
  }

  /* Cadre de la photo : seul porteur d'overflow: hidden ; ses dimensions sont réservées avant le chargement. */
  .frame {
    box-sizing: border-box;
    inline-size: 100%;
    max-inline-size: var(--container);
    block-size: var(--hero-light-photo-height);
    margin-block-start: calc(var(--hero-light-photo-gap) - var(--space-2));
    overflow: hidden;
  }

  @media (width < 960px) {
    .frame {
      block-size: auto;
      aspect-ratio: var(--photo-ratio-tablet);
    }
  }

  @media (width < 700px) {
    .frame {
      aspect-ratio: var(--photo-ratio-portrait);
    }
  }

  .frame :global(picture) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .frame :global(.photo) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: var(--photo-position);
    animation: light-zoom var(--hero-zoom-duration) var(--ease) both;
  }

  @keyframes light-zoom {
    from {
      transform: scale(var(--hero-zoom-from));
    }

    to {
      transform: none;
    }
  }

  /* h1 : translation seule, visible dès la première image. */
  @keyframes light-rise-title {
    from {
      transform: translateY(var(--rise-distance));
    }

    to {
      transform: none;
    }
  }

  @keyframes light-rise {
    from {
      opacity: var(--rise-opacity-from);
      transform: translateY(var(--rise-distance));
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
