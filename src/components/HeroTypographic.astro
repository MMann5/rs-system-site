---
// UX-DR15, UX-DR38 : héros typographique (DESIGN.md › Components › Héros typographique), repris par la 404,
// la page ville (story 4.1) et plus tard À propos. Fond navy-deep, aligné au début : sur-titre (slot `eyebrow`,
// fil d'Ariane de la ville), h1 (`titleSize` : page-title, ou city-title pour la ville), puis le slot (corps).
// Arcs de signal (décision D7 de l'epic 4) : les trois ondes du logo, pleines, au coin de fin, jamais retournées
// en RTL, tracées une fois ; prefers-reduced-motion coupe l'animation (base.css) et laisse les arcs dessinés.
// Aucun arc derrière un texte ou un lien :
// - au-dessus de 960px, le corps (sous le h1) réserve à sa fin d'inline la largeur des arcs (--arcs-ink-inline)
//   et sa hauteur garantit que le haut du dessin (--arcs-ink-block) reste sous le h1 et le sur-titre ;
// - sous 960px, le texte occupe toute la largeur : les arcs, réduits (--arcs-scale-mobile), sont réservés sous lui.
interface Props {
  title: string;
  /** Taille du h1 : `page` (page-title, 404 et À propos) ou `city` (city-title, page ville). */
  titleSize?: 'page' | 'city';
}

const { title, titleSize = 'page' } = Astro.props;
---
<section class="hero-typo" aria-labelledby="page-title" data-surface="navy">
  <div class="arcs">
    <svg aria-hidden="true" focusable="false" viewBox="0 0 480 480">
      <path class="arc arc-1" pathLength="1" d="M100 270 A110 110 0 0 1 208.9 395.3" />
      <path class="arc arc-2" pathLength="1" d="M100 205 A175 175 0 0 1 270.5 419.4" />
      <path class="arc arc-3" pathLength="1" d="M100 138 A242 242 0 0 1 330.2 454.8" />
    </svg>
  </div>
  <div class="content">
    <slot name="eyebrow" />
    <h1 id="page-title" class:list={['title', { city: titleSize === 'city' }]}>{title}</h1>
    <div class="body">
      <slot />
    </div>
  </div>
</section>

<style>
  /* Seuils (les @media ne lisent pas les tokens) : --bp-menu 960px, --bp-mobile-bar 700px. */
  .hero-typo {
    position: relative;
    isolation: isolate;
    padding-block: var(--section-y);
    padding-inline: var(--page-gutter);
    background-color: var(--color-navy-deep);
    color: var(--color-white);
  }

  /* Sous 960px, le texte occupe toute la largeur : on réserve sous lui la hauteur visible du dessin réduit
     (haut du tracé, moins le débord bas, plus la marge), pour qu'aucun arc ne passe derrière un texte ou un lien. */
  @media (width < 960px) {
    .hero-typo {
      padding-block: var(--section-y-tablet)
        calc(
          var(--section-y-tablet) +
            (var(--arcs-size) * var(--arcs-ink-block) + var(--arcs-offset-block) + var(--arcs-clearance)) *
            var(--arcs-scale-mobile)
        );
    }
  }

  @media (width < 700px) {
    .hero-typo {
      padding-block: var(--section-y-mobile)
        calc(
          var(--section-y-mobile) +
            (var(--arcs-size) * var(--arcs-ink-block) + var(--arcs-offset-block) + var(--arcs-clearance)) *
            var(--arcs-scale-mobile)
        );
    }
  }

  /* Seul porteur d'overflow: hidden : le cadre des arcs, jamais le texte. */
  .arcs {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .arcs svg {
    position: absolute;
    inset-inline-end: var(--arcs-offset-inline);
    inset-block-end: var(--arcs-offset-block);
    inline-size: var(--arcs-size);
    block-size: var(--arcs-size);
  }

  @media (width < 960px) {
    .arcs svg {
      inset-inline-end: calc(var(--arcs-offset-inline) * var(--arcs-scale-mobile));
      inset-block-end: calc(var(--arcs-offset-block) * var(--arcs-scale-mobile));
      inline-size: calc(var(--arcs-size) * var(--arcs-scale-mobile));
      block-size: calc(var(--arcs-size) * var(--arcs-scale-mobile));
    }
  }

  .arc {
    fill: none;
    stroke: var(--color-signal-arc);
    stroke-width: var(--arc-stroke-width);
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: arc-draw var(--arc-duration) var(--ease) var(--arc-delay-1) both;
  }

  .arc-2 {
    animation-delay: var(--arc-delay-2);
  }

  .arc-3 {
    animation-delay: var(--arc-delay-3);
  }

  /* Dans le flux, au-dessus des arcs : la section grandit avec le texte (russe, zoom). */
  .content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-inline-size: var(--container);
    margin-inline: auto;
  }

  .title {
    margin: 0;
    font-size: var(--type-page-title-size);
    font-weight: var(--type-page-title-weight);
    line-height: var(--type-page-title-leading);
    color: var(--color-white);
  }

  /* Page ville : city-title, borne basse 40px ; un nom long passe à la ligne au tiret (base.css : overflow-wrap). */
  .title.city {
    max-inline-size: 100%;
    font-size: var(--type-city-title-size);
    font-weight: var(--type-city-title-weight);
    line-height: var(--type-city-title-leading);
  }

  /* Corps : sous-titre, numéro, liens. Même rythme vertical que la colonne. */
  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    box-sizing: border-box;
    inline-size: 100%;
  }

  /* Au-dessus de 960px, les arcs gardent leur taille : le corps s'écarte de leur colonne (fin d'inline, mesurée
     dans le sens le plus large des deux, LTR) et occupe au moins leur hauteur visible, moins le padding bas. */
  @media (width >= 960px) {
    .body {
      min-block-size: calc(
        var(--arcs-size) * var(--arcs-ink-block) + var(--arcs-offset-block) + var(--arcs-clearance) - var(--section-y)
      );
      padding-inline-end: calc(
        var(--arcs-size) * var(--arcs-ink-inline) + var(--arcs-offset-inline) + var(--arcs-clearance) - var(--page-gutter)
      );
    }
  }

  @keyframes arc-draw {
    from {
      stroke-dashoffset: 1;
    }
  }
</style>
