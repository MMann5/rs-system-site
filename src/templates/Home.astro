---
// FR1, FR21 (story 1.8) : accueil = héros photo puis bloc contact. Textes depuis src/i18n, photo
// Pexels n° 31737862 (décision D5) en paysage et en recadrage 4:5 (src/assets/photos/).
// AD-13 : construit son contexte de page et rend le layout unique.
import heroPortrait from '../assets/photos/home-hero-portrait.jpg';
import hero from '../assets/photos/home-hero.jpg';
import ContactBand from '../components/ContactBand.astro';
import HeroPhoto from '../components/HeroPhoto.astro';
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n';
import type { Lang } from '../lib/langs';
import { createPageContext } from '../lib/page-context';
import { page } from '../lib/pages';

interface Props {
  id: string;
  lang: Lang;
}

const { id, lang } = Astro.props;
const ctx = createPageContext({ id, lang });
const { meta } = page(id);
---
<Base ctx={ctx} title={meta.title[lang]} description={meta.description[lang]}>
  <HeroPhoto
    ctx={ctx}
    photo={{ src: hero, portrait: heroPortrait, alt: t(lang, 'home.hero.alt') }}
    title={t(lang, 'home.hero.title')}
    subtitle={t(lang, 'home.hero.subtitle')}
  />
  <ContactBand ctx={ctx} />
</Base>
