---
// FR9, FR29, FR31, NFR2, UX-DR15, UX-DR22, AD-2, AD-4, AD-5, AD-7, AD-8, AD-13, décisions D1, D5, D7 de l'epic 4
// (story 4.1) : modèle des pages ville (canvas City.dc.html), piloté par l'id `city:{id}`. Ordre de <main> :
// héros typographique navy (fil d'Ariane région, h1 nom de la ville, intro, Appeler › WhatsApp › הצעת מחיר ›),
// « ce qu'on installe à {ville} » (5 lignes vers les pages services générales), localités alentour (texte, sans
// liens ; placeholder tant qu'aucune n'est fournie), étapes, bloc contact. Story 4.3 (FR41, UX-DR24, D3, D4) : entre
// « ce qu'on installe » et les localités, 0 à 2 avis Midrag (fond surface-alt, aria-label sans titre visible) ;
// section absente si la ville n'a pas d'avis.
// Contexte de page (AD-13) : `city` et `navSection: 'areas'` ; héros, barre mobile et bloc contact en tirent le
// message WhatsApp « …ב{nom hébreu} » et le `?city=` des liens Contact. Données : src/content/cities/{id}.yaml.
import CityReviews from '../components/CityReviews.astro';
import ContactBand from '../components/ContactBand.astro';
import HeroTypographic from '../components/HeroTypographic.astro';
import Placeholder from '../components/Placeholder.astro';
import Steps from '../components/Steps.astro';
import TextLink from '../components/TextLink.astro';
import Base from '../layouts/Base.astro';
import { CITY_ID_PREFIX, city as findCity, region as findRegion, reviewsOf } from '../lib/areas';
import { bandLinks } from '../lib/contact/band';
import { telHref, waHref } from '../lib/contact/core';
import { cityLabels, serviceLabels, servicePage } from '../lib/contact/labels';
import { pageWaInput } from '../lib/contact/table';
import { t } from '../lib/i18n';
import type { Lang } from '../lib/langs';
import { createPageContext } from '../lib/page-context';
import { isEnabled, url } from '../lib/routes';

interface Props {
  id: string;
  lang: Lang;
}

/** Lignes « ce qu'on installe », dans l'ordre du canvas City (pas celui du header). */
const SERVICE_ROWS = ['cameras', 'smoke-detectors', 'intercom', 'smart-home', 'networks'] as const;

const { id, lang } = Astro.props;
if (!id.startsWith(CITY_ID_PREFIX)) throw new Error(`City : id « ${id} » hors du type city:`);
const cityId = id.slice(CITY_ID_PREFIX.length);
const city = findCity(cityId);
const region = findRegion(city.region);
const name = city.name[lang];
const ctx = createPageContext({ id, lang, city: cityId, navSection: 'areas' });

// Fil d'Ariane : lien vers la région sur Zones seulement si `areas` est active ; `url('areas')` jamais appelé sinon.
const areasHref = isEnabled('areas') ? url('areas', lang, { hash: region.anchor }) : undefined;
const wa = waHref(pageWaInput(ctx, serviceLabels('he'), cityLabels('he')));
// D5 : « הצעת מחיר › » vers Contact `?city={id}`, sans service ; omis si `contact` est inactif.
const { detailsHref: quoteHref } = bandLinks({ lang, city: cityId }, { isEnabled, url });
const services = serviceLabels(lang);
// Une ligne par service dont la page est active (FR23) ; `url` n'est jamais appelé pour une page inactive.
const rows = SERVICE_ROWS.flatMap((code) => {
  const page = servicePage(code);
  if (page === undefined || !isEnabled(page)) return [];
  return [{ code, href: url(page, lang), label: services[code].label, hint: t(lang, `city.service-hint.${code}`) }];
});
const neighbors = city.neighbors.map((n) => n[lang]);
const reviews = reviewsOf(cityId);
---
<Base ctx={ctx} title={t(lang, 'city.meta-title').replace('{city}', name)} description={city.intro[lang]}>
  <HeroTypographic title={name} titleSize="city">
    {areasHref ? (
      <nav slot="eyebrow" class="crumb" aria-label={t(lang, 'city.breadcrumb-label')}>
        <a href={areasHref} class="crumb-link">{t(lang, 'nav.areas')}<span aria-hidden="true">{' › '}</span>{region.name[lang]}</a>
      </nav>
    ) : (
      <p slot="eyebrow" class="crumb crumb-text">{region.name[lang]}</p>
    )}
    <p class="subtitle">{city.intro[lang]}</p>
    <div class="links">
      <TextLink href={telHref()} label={t(lang, 'action.call')} tone="night" track="call_click" placement="hero" />
      <TextLink href={wa} label={t(lang, 'action.whatsapp')} tone="night" track="whatsapp_click" placement="hero" />
      {quoteHref && <TextLink href={quoteHref} label={t(lang, 'action.quote')} tone="night" />}
    </div>
  </HeroTypographic>

  {rows.length > 0 && (
    <section class="section reveal" aria-labelledby="city-services-title">
      <div class="inner">
        <h2 id="city-services-title" class="services-title">{t(lang, 'city.services.title').replace('{city}', name)}</h2>
        <ul role="list" class="rows">
          {rows.map((row) => (
            <li>
              <a href={row.href} class="row">
                <span class="row-label">{row.label}</span>
                <span class="row-hint">{row.hint}<span aria-hidden="true">{' ›'}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {reviews.length > 0 && (
    <section class="section section-alt reveal" aria-label={t(lang, 'city.reviews.label').replace('{city}', name)}>
      <div class="inner">
        <CityReviews reviews={reviews} />
      </div>
    </section>
  )}

  <section class="section reveal" aria-labelledby="city-neighbors-title">
    <div class="inner neighbors">
      <h2 id="city-neighbors-title" class="neighbors-title">{t(lang, 'city.neighbors.title')}</h2>
      <p class="neighbors-text">
        {neighbors.length > 0 ? neighbors.join(' · ') : <Placeholder text={t(lang, 'placeholder.neighbors')} />}
      </p>
    </div>
  </section>

  <Steps lang={lang} />
  <ContactBand ctx={ctx} />
</Base>

<style>
  /* Seuils (les @media ne lisent pas les tokens) : --bp-menu 960px, --bp-mobile-bar 700px. */

  /* — Héros : fil d'Ariane (sur-titre 18px/600 link-on-night), intro, liens « › » ton nuit — */
  .crumb {
    font-size: var(--type-breadcrumb-size);
    font-weight: var(--type-breadcrumb-weight);
    line-height: var(--type-text-link-leading);
    color: var(--color-link-on-night);
  }

  .crumb-text {
    margin: 0;
  }

  /* Recette 4.1 : en flex, les espaces autour du chevron « › » tombent ; l'écart vient de column-gap. */
  .crumb-link {
    display: inline-flex;
    align-items: center;
    column-gap: var(--space-2);
    min-block-size: var(--space-12);
    color: var(--color-link-on-night);
    text-decoration: none;
  }

  .crumb-link:hover,
  .crumb-link:focus-visible {
    text-decoration: underline;
  }

  .subtitle {
    max-inline-size: var(--hero-typo-subtitle-max);
    margin: 0;
    font-size: var(--type-section-subhead-size);
    font-weight: var(--type-section-subhead-weight);
    line-height: var(--type-section-subhead-leading);
    color: var(--color-nav-idle);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--link-gap);
  }

  /* — Sections : « ce qu'on installe », localités alentour (blanches), avis Midrag (surface-alt) — */
  .section {
    padding-block: var(--section-y);
    padding-inline: var(--page-gutter);
    background-color: var(--color-surface);
    color: var(--color-ink);
  }

  @media (width < 960px) {
    .section {
      padding-block: var(--section-y-tablet);
    }
  }

  @media (width < 700px) {
    .section {
      padding-block: var(--section-y-mobile);
    }
  }

  .section-alt {
    background-color: var(--color-surface-alt);
  }

  .inner {
    max-inline-size: var(--container);
    margin-inline: auto;
  }

  .services-title {
    margin: 0 0 var(--row-list-head-gap);
    font-size: var(--type-city-section-title-size);
    font-weight: var(--type-city-section-title-weight);
    line-height: var(--type-city-section-title-leading);
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Ligne entière cliquable ≥ 56px : filet en haut, et en bas pour la dernière ; libellé h2 au début,
     description et chevron « › » (retourné par le bidi) à la fin ; passe à la ligne si la place manque. */
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--row-gap);
    box-sizing: border-box;
    min-block-size: var(--row-min-height);
    padding-block: var(--row-pad-block);
    border-block-start: var(--row-rule-width) solid var(--color-line);
    color: var(--color-ink);
    text-decoration: none;
  }

  li:last-child .row {
    border-block-end: var(--row-rule-width) solid var(--color-line);
  }

  .row:hover .row-label,
  .row:focus-visible .row-label {
    text-decoration: underline;
  }

  .row-label {
    font-size: var(--type-h2-size);
    font-weight: var(--type-h2-weight);
    line-height: var(--type-h2-leading);
  }

  .row-hint {
    font-size: var(--type-row-hint-size);
    line-height: var(--type-body-leading);
    color: var(--color-ink-muted);
  }

  .neighbors {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .neighbors-title {
    margin: 0;
    font-size: var(--type-h2-size);
    font-weight: var(--type-h2-weight);
    line-height: var(--type-h2-leading);
  }

  .neighbors-text {
    margin: 0;
    font-size: var(--type-neighbors-size);
    line-height: var(--type-neighbors-leading);
    color: var(--color-ink-muted);
  }
</style>
