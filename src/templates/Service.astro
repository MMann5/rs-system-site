---
// FR2, FR21, FR22, FR23, FR31, AD-2, AD-4, AD-9, AD-13 (story 3.1) : modèle des pages services, piloté par
// l'id. Ordre : héros clair, trio « pour qui », tuile (si la page en a une), étapes, bloc contact.
// Textes propres à la page : src/content/pages/{id}.yaml (bloc `service`) ; étapes et libellés : src/i18n.
// Contexte de page (AD-13) : service et section de navigation de la page, lus dans SERVICE_PAGES ; la barre
// mobile, le héros et le bloc contact en tirent le message WhatsApp et le lien Devis.
// Photos importées statiquement, par id (décision D1 : originaux Pexels, src/assets/photos/).
// Story 3.2 (FR3) : héros discriminé, photo encadrée ou détecteur illustré (Détecteurs, sans photo ni tuile).
// Story 3.3 (FR4, FR6) : Maison connectée (photo interrupteur, cadre 4:3 sous 700px, sans tuile) et Interphone
// (photo interphone, 4:3 sous 700px, tuile immeuble navy-deep avec « תיאום סיור טכני › » → Contact ?service=intercom).
// Story 3.4 (FR5, FR7, UX-DR13) : héros `cover` = héros photo sombre plein cadre (HeroPhoto.astro, celui de l'accueil,
// en variante) pour Réseaux (baie réseau, scrim-network, 760px) et Entrepreneurs (grue, scrim-crane, 820px, sur-titre,
// « הצעת מחיר לאתר › » → ?service=crane-cameras, tuile immeuble « לפרטים › » → Réseaux). Les autres pages gardent
// HeroLight. Le service d'Entrepreneurs est `crane-cameras` (services.yaml), pas l'id de la page.
import type { ImageMetadata } from 'astro';
import buildingPortrait from '../assets/photos/building-night-portrait.jpg';
import building from '../assets/photos/building-night.jpg';
// Correctif 3.1 (D5) : recadrage téléphone de la grue centré sur le mât et la cabine, commun à la tuile de Caméras
// et au héros Entrepreneurs (cabine sous le bloc de texte à 320 et 390px).
import cranePortrait from '../assets/photos/crane-mast-portrait.jpg';
import crane from '../assets/photos/crane.jpg';
import domePortrait from '../assets/photos/cameras-dome-portrait.jpg';
import dome from '../assets/photos/cameras-dome.jpg';
import networkPortrait from '../assets/photos/network-portrait.jpg';
import network from '../assets/photos/network.jpg';
import intercomMobile from '../assets/photos/intercom-panel-mobile.jpg';
import intercomPanel from '../assets/photos/intercom-panel.jpg';
import switchMobile from '../assets/photos/smart-switch-mobile.jpg';
import smartSwitch from '../assets/photos/smart-switch.jpg';
import ContactBand from '../components/ContactBand.astro';
import HeroLight from '../components/HeroLight.astro';
import HeroPhoto from '../components/HeroPhoto.astro';
import ProductCards from '../components/ProductCards.astro';
import SmokeDetector from '../components/SmokeDetector.astro';
import Steps from '../components/Steps.astro';
import Tile, { type TileLink } from '../components/Tile.astro';
import Trio from '../components/Trio.astro';
import Base from '../layouts/Base.astro';
import { bandLinks } from '../lib/contact/band';
import { t } from '../lib/i18n';
import type { Lang } from '../lib/langs';
import { createPageContext } from '../lib/page-context';
import { cardsFor } from '../lib/products/cards';
import { page } from '../lib/pages';
import { isEnabled, url } from '../lib/routes';
import { heroCover, heroPhoto, tileLinks as resolveTileLinks, type HeroDef, type TileLinkDef } from '../lib/service-hero';

interface Props {
  id: string;
  lang: Lang;
}

interface ServicePage {
  /** Code `?service=` (src/content/services.yaml). */
  service: string;
  /**
   * Héros clair : photo encadrée (`alt` requis dans le YAML) ou détecteur illustré de 380px qui monte ;
   * ou héros photo sombre plein cadre (`cover`, `alt` requis).
   */
  hero: HeroDef<ImageMetadata>;
  /** Tuile sombre de la page (lien discriminé, voir TileLinkDef). */
  tile?: {
    src: ImageMetadata;
    portrait: ImageMetadata;
    focus: 'crane' | 'building';
    background: 'tile-night' | 'navy-deep';
    scrim: 'crane' | 'tile';
    motion: 'parallax' | 'zoom';
    size: 'crane' | 'building';
    link: TileLinkDef;
  };
}

// Lien unique de la tuile (`details` → page cible active, `visit` → Contact) : voir TileLinkDef (service-hero.ts).

const SERVICE_PAGES: Record<string, ServicePage> = {
  cameras: {
    service: 'cameras',
    hero: { kind: 'photo', src: dome, portrait: domePortrait, focus: 'dome' },
    tile: {
      src: crane,
      portrait: cranePortrait,
      focus: 'crane',
      background: 'tile-night',
      scrim: 'crane',
      motion: 'parallax',
      size: 'crane',
      link: { kind: 'details', page: 'contractors' },
    },
  },
  'smoke-detectors': {
    service: 'smoke-detectors',
    hero: { kind: 'detector' },
  },
  'smart-home': {
    service: 'smart-home',
    hero: { kind: 'photo', src: smartSwitch, portrait: switchMobile, focus: 'switch', mobile: 'landscape' },
  },
  networks: {
    service: 'networks',
    hero: { kind: 'cover', src: network, portrait: networkPortrait, focus: 'network', scrim: 'network', size: 'networks', quote: 'quote' },
  },
  intercom: {
    service: 'intercom',
    hero: { kind: 'photo', src: intercomPanel, portrait: intercomMobile, focus: 'intercom', mobile: 'landscape' },
    tile: {
      src: building,
      portrait: buildingPortrait,
      focus: 'building',
      background: 'navy-deep',
      scrim: 'tile',
      motion: 'zoom',
      size: 'building',
      link: { kind: 'visit' },
    },
  },
  contractors: {
    service: 'crane-cameras',
    hero: { kind: 'cover', src: crane, portrait: cranePortrait, focus: 'crane', scrim: 'crane', size: 'contractors', quote: 'quote-site' },
    tile: {
      src: building,
      portrait: buildingPortrait,
      focus: 'building',
      background: 'navy-deep',
      scrim: 'tile',
      motion: 'zoom',
      size: 'building',
      link: { kind: 'details', page: 'networks' },
    },
  },
};

const { id, lang } = Astro.props;
const def = SERVICE_PAGES[id];
const { meta, service: content } = page(id);
if (!def) throw new Error(`Service : aucune page service « ${id} » dans SERVICE_PAGES`);
if (!content) throw new Error(`Service : bloc « service » absent de src/content/pages/${id}.yaml`);
// AD-4 : `alt` facultatif au schéma (héros illustré), mais obligatoire pour un héros à photo (heroPhoto lève).
const photo = heroPhoto(id, def.hero, content.hero.alt, lang);
const cover = heroCover(id, def.hero, content.hero.alt, lang);
const ctx = createPageContext({ id, lang, service: def.service, navSection: id });
const tile = def.tile && content.tile ? { def: def.tile, text: content.tile } : undefined;
// Lien de la tuile : seulement si sa cible est active (FR23) ; `url` n'est jamais appelé sinon.
const tileLinks: TileLink[] = tile ? resolveTileLinks(tile.def.link, { lang, service: ctx.service }, { isEnabled, url, t }) : [];
// Héros sombre : Devis › vers Contact avec `?service=` du contexte (bandLinks, comme HeroLight), omis si `contact` est inactif.
const { detailsHref: quoteHref } = bandLinks({ lang, service: ctx.service }, { isEnabled, url });
// Pages produits : cartes des produits actifs de cette page, après le trio (section absente sans produit).
const products = cardsFor(id, lang);
const quote = cover && quoteHref ? { href: quoteHref, label: t(lang, cover.quoteKey) } : undefined;
---
<Base ctx={ctx} title={meta.title[lang]} description={meta.description[lang]}>
  {cover ? (
    <HeroPhoto
      ctx={ctx}
      photo={cover.photo}
      title={content.hero.title[lang]}
      subtitle={content.hero.subtitle[lang]}
      eyebrow={content.hero.eyebrow?.[lang]}
      quote={quote}
      variant={cover.variant}
      titleSize="page"
    />
  ) : (
    <HeroLight ctx={ctx} photo={photo} title={content.hero.title[lang]} subtitle={content.hero.subtitle[lang]}>
      {def.hero.kind === 'detector' && <SmokeDetector size="lg" rise />}
    </HeroLight>
  )}
  <Trio
    id="trio-title"
    title={content.trio.title[lang]}
    items={content.trio.items.map((item) => ({ title: item.title[lang], text: item.text[lang] }))}
  />
  {products.length > 0 && <ProductCards id="products-title" title={t(lang, 'products.title')} items={products} />}
  {tile && (
    <Tile
      variant="dark"
      id="tile-title"
      level="h2"
      eyebrow={tile.text.eyebrow?.[lang]}
      title={tile.text.title[lang]}
      text={tile.text.text[lang]}
      links={tileLinks}
      photo={{ src: tile.def.src, portrait: tile.def.portrait, alt: tile.text.alt[lang], focus: tile.def.focus }}
      background={tile.def.background}
      scrim={tile.def.scrim}
      motion={tile.def.motion}
      size={tile.def.size}
    />
  )}
  <Steps lang={lang} />
  <ContactBand ctx={ctx} />
</Base>
